# Copier en .env (jamais versionné) et remplir.
# Jeton GitHub à portée fine : lecture du dépôt, des issues, des PR et des Actions.
GITHUB_TOKEN=
# Dépôt suivi par l'IHM, au format proprietaire/nom. Laisser vide : l'IHM lit alors « git remote origin ».
GITHUB_REPO=
# Port local de l'IHM (4173 par défaut).
IHM_PORT=
