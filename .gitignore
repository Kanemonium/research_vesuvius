# Secrets : jamais dans l'historique
.env
.env.*
!.env.example

# Données et modèles : téléchargés, jamais versionnés (voir docs/architecture.md)
/data/
/models/
*.zarr/
*.ckpt
*.pth
*.safetensors
wandb/

# Node
node_modules/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/

# Outils locaux
.claude/settings.local.json
.DS_Store
Thumbs.db

# Lectures de Discord : des messages d'autres personnes, qui restent sur la machine
/local/

# Journaux d'exécution : le brut reste sur la machine, seul le condensé est historisé
experiments/**/journaux/*.brut.log
experiments/**/journaux/*.vram
experiments/**/journaux/*.etape
